<body>

    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>🧠 Memory Match</h1>
        </div>
        <div class="subtitle">Memorize, then match the pairs!</div>

        <!-- Top Controls -->
        <div class="top-controls">
            <div class="control-group">
                <label for="difficultySelect">📐</label>
                <select id="difficultySelect">
                    <option value="4">4×4 (Easy)</option>
                    <option value="6" selected>6×6 (Medium)</option>
                    <option value="8">8×8 (Hard)</option>
                </select>
            </div>
            <div class="control-group">
                <label>🎨</label>
                <div class="mode-toggle">
                    <button class="active" data-mode="colors">Colors</button>
                    <button data-mode="emoji">Emoji</button>
                </div>
            </div>
            <button class="btn-new-game" id="newGameBtn">🔄 New Game</button>
        </div>

        <!-- Phase Banner -->
        <div class="phase-banner idle" id="phaseBanner">🔄 Click "New Game" to start</div>

        <!-- Stats -->
        <div class="stats-bar">
            <span class="stat">🎯 Attempts: <span class="value attempts" id="attemptsDisplay">0</span></span>
            <span class="stat">✅ Matches: <span class="value matches" id="matchesDisplay">0</span>/<span id="totalPairsDisplay">18</span></span>
            <span class="stat">⏱️ Time: <span class="value" id="timeDisplay">0s</span></span>
            <span class="stat">🏆 Best: <span class="value" id="bestDisplay">—</span></span>
        </div>

        <!-- Board -->
        <div class="board-wrapper">
            <div class="board grid-6" id="board" role="grid" aria-label="Memory match game board"></div>

            <!-- Win Overlay -->
            <div class="win-overlay" id="winOverlay" role="dialog" aria-modal="true">
                <div class="big-icon">🎉</div>
                <div class="win-title">All Matched!</div>
                <div class="win-details" id="winDetails">
                    Attempts: <span id="winAttempts">0</span> &nbsp;·&nbsp;
                    Time: <span id="winTime">0s</span> &nbsp;·&nbsp;
                    Score: <span id="winScore">0</span>
                </div>
                <button class="btn" id="playAgainBtn">🔄 Play Again</button>
            </div>
        </div>

        <!-- Status & Controls -->
        <div class="status-bar-bottom">
            <span class="status-text waiting" id="statusText">⏳ Press "New Game" to start</span>
            <span class="timer-display" id="timerDisplay">⏱️ 0s</span>
        </div>

        <div class="controls">
            <button class="sound-toggle" id="soundToggle" title="Toggle sound" aria-label="Toggle sound">🔊</button>
            <span style="color:#8b949e;font-size:13px;margin-left:auto;">
                ⭐ <span id="scoreDisplay">—</span>
            </span>
        </div>
    </div>

    <script>
        // ============================================================
        //  MEMORY MATCH — ULTIMATE EDITION V2
        //  "New Game" button starts the memorize timer
        // ============================================================

        // ============================================================
        //  CONFIGURATION
        // ============================================================

        const MEMORIZE_TIME = 10; // seconds

        const EMOJIS = [
            '🐶', '🐱', '🐭', '🐹', '🐰', '🦊', '🐻', '🐼',
            '🐨', '🐯', '🦁', '🐮', '🐷', '🐸', '🐵', '🐔',
            '🐧', '🐦', '🐤', '🐣', '🐥', '🦆', '🦅', '🦉',
            '🐺', '🐗', '🐴', '🦄', '🐝', '🪲', '🐞', '🦋',
            '🐙', '🦑', '🐬', '🐳', '🐊', '🦈', '🐋', '🦀',
            '🍎', '🍐', '🍊', '🍋', '🍌', '🍉', '🍇', '🍓',
            '🫐', '🍒', '🍑', '🥭', '🍍', '🥥', '🥝', '🍅',
            '⭐', '🌙', '☀️', '⚡', '🔥', '💧', '❄️', '🌈',
            '❤️', '🧡', '💛', '💚', '💙', '💜', '🖤', '🤍'
        ];

        const DIFFICULTIES = {
            4: { grid: 4, pairs: 8, label: '4×4 (Easy)' },
            6: { grid: 6, pairs: 18, label: '6×6 (Medium)' },
            8: { grid: 8, pairs: 32, label: '8×8 (Hard)' }
        };

        // ============================================================
        //  SOUND ENGINE
        // ============================================================

        let audioCtx = null;
        let soundEnabled = true;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new(window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            document.getElementById('soundToggle').textContent = soundEnabled ? '🔊' : '🔇';
            if (soundEnabled) initAudio();
        }

        function playFlip() {
            if (!soundEnabled) return;
            try {
                initAudio();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.frequency.setValueAtTime(600, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(800, audioCtx.currentTime + 0.06);
                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.08);
                osc.start(audioCtx.currentTime);
                osc.stop(audioCtx.currentTime + 0.08);
            } catch (_) { /* ignore */ }
        }

        function playMatch() {
            if (!soundEnabled) return;
            try {
                initAudio();
                const notes = [523, 659];
                for (let i = 0; i < notes.length; i++) {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.frequency.setValueAtTime(notes[i], audioCtx.currentTime + i * 0.08);
                    gain.gain.setValueAtTime(0.12, audioCtx.currentTime + i * 0.08);
                    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + i * 0.08 + 0.12);
                    osc.start(audioCtx.currentTime + i * 0.08);
                    osc.stop(audioCtx.currentTime + i * 0.08 + 0.12);
                }
            } catch (_) { /* ignore */ }
        }

        function playMismatch() {
            if (!soundEnabled) return;
            try {
                initAudio();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sawtooth';
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.frequency.setValueAtTime(300, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(200, audioCtx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.15);
                osc.start(audioCtx.currentTime);
                osc.stop(audioCtx.currentTime + 0.15);
            } catch (_) { /* ignore */ }
        }

        function playWin() {
            if (!soundEnabled) return;
            try {
                initAudio();
                const notes = [523, 587, 659, 784, 880, 784, 880];
                for (let i = 0; i < notes.length; i++) {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = i % 2 === 0 ? 'square' : 'sine';
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    const time = audioCtx.currentTime + i * 0.07;
                    osc.frequency.setValueAtTime(notes[i], time);
                    gain.gain.setValueAtTime(0.08, time);
                    gain.gain.exponentialRampToValueAtTime(0.001, time + 0.12);
                    osc.start(time);
                    osc.stop(time + 0.12);
                }
            } catch (_) { /* ignore */ }
        }

        function playHighScore() {
            if (!soundEnabled) return;
            try {
                initAudio();
                const notes = [587, 659, 784, 880, 988, 880, 988];
                for (let i = 0; i < notes.length; i++) {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = i % 2 === 0 ? 'square' : 'sine';
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    const time = audioCtx.currentTime + i * 0.06;
                    osc.frequency.setValueAtTime(notes[i], time);
                    gain.gain.setValueAtTime(0.1, time);
                    gain.gain.exponentialRampToValueAtTime(0.001, time + 0.1);
                    osc.start(time);
                    osc.stop(time + 0.1);
                }
            } catch (_) { /* ignore */ }
        }

        function playMemorizeStart() {
            if (!soundEnabled) return;
            try {
                initAudio();
                const notes = [440, 523, 659];
                for (let i = 0; i < notes.length; i++) {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    const time = audioCtx.currentTime + i * 0.15;
                    osc.frequency.setValueAtTime(notes[i], time);
                    gain.gain.setValueAtTime(0.08, time);
                    gain.gain.exponentialRampToValueAtTime(0.001, time + 0.12);
                    osc.start(time);
                    osc.stop(time + 0.12);
                }
            } catch (_) { /* ignore */ }
        }

        function playMemorizeEnd() {
            if (!soundEnabled) return;
            try {
                initAudio();
                const notes = [659, 523, 440];
                for (let i = 0; i < notes.length; i++) {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    const time = audioCtx.currentTime + i * 0.12;
                    osc.frequency.setValueAtTime(notes[i], time);
                    gain.gain.setValueAtTime(0.08, time);
                    gain.gain.exponentialRampToValueAtTime(0.001, time + 0.1);
                    osc.start(time);
                    osc.stop(time + 0.1);
                }
            } catch (_) { /* ignore */ }
        }

        // ============================================================
        //  GAME ENGINE
        // ============================================================

        let cards = [];
        let flippedCards = [];
        let matchedPairs = 0;
        let attempts = 0;
        let isLocked = false;
        let gameStarted = false;
        let startTime = 0;
        let timerInterval = null;
        let elapsedSeconds = 0;
        let bestScore = Infinity;
        let currentScore = 0;
        let isMemorizePhase = false;
        let memorizeTimer = null;
        let remainingMemorizeTime = MEMORIZE_TIME;
        let isGameReady = false;
        let currentDifficulty = 6;
        let currentMode = 'colors';
        let totalPairs = 18;
        let isGameActive = false;

        // DOM refs
        const board = document.getElementById('board');
        const statusText = document.getElementById('statusText');
        const attemptsDisplay = document.getElementById('attemptsDisplay');
        const matchesDisplay = document.getElementById('matchesDisplay');
        const totalPairsDisplay = document.getElementById('totalPairsDisplay');
        const timeDisplay = document.getElementById('timeDisplay');
        const timerDisplay = document.getElementById('timerDisplay');
        const bestDisplay = document.getElementById('bestDisplay');
        const scoreDisplay = document.getElementById('scoreDisplay');
        const winOverlay = document.getElementById('winOverlay');
        const winAttempts = document.getElementById('winAttempts');
        const winTime = document.getElementById('winTime');
        const winScore = document.getElementById('winScore');
        const newGameBtn = document.getElementById('newGameBtn');
        const playAgainBtn = document.getElementById('playAgainBtn');
        const soundToggle = document.getElementById('soundToggle');
        const phaseBanner = document.getElementById('phaseBanner');
        const difficultySelect = document.getElementById('difficultySelect');
        const modeToggleButtons = document.querySelectorAll('.mode-toggle button');

        soundToggle.addEventListener('click', toggleSound);

        function loadBestScore() {
            const key = `memoryMatchBest_${currentDifficulty}_${currentMode}`;
            bestScore = parseInt(localStorage.getItem(key)) || Infinity;
            updateBestDisplay();
        }

        function saveBestScore() {
            const key = `memoryMatchBest_${currentDifficulty}_${currentMode}`;
            localStorage.setItem(key, bestScore);
        }

        function updateBestDisplay() {
            if (bestScore === Infinity) {
                bestDisplay.textContent = '—';
            } else {
                const bestAttempts = Math.floor(bestScore / 100);
                const bestTime = (bestScore % 100) / 10;
                bestDisplay.textContent = `${bestAttempts} attempts, ${bestTime.toFixed(1)}s`;
            }
        }

        function updateDifficulty() {
            const val = parseInt(difficultySelect.value);
            currentDifficulty = val;
            const config = DIFFICULTIES[val];
            totalPairs = config.pairs;
            totalPairsDisplay.textContent = totalPairs;
            board.className = `board grid-${val}`;
            loadBestScore();
            resetToIdle();
        }

        function updateMode(mode) {
            currentMode = mode;
            modeToggleButtons.forEach(btn => {
                btn.classList.toggle('active', btn.dataset.mode === mode);
            });
            loadBestScore();
            resetToIdle();
        }

        function resetToIdle() {
            // Clear any game state
            if (timerInterval) clearInterval(timerInterval);
            if (memorizeTimer) clearInterval(memorizeTimer);
            timerInterval = null;
            memorizeTimer = null;

            isGameActive = false;
            isMemorizePhase = false;
            isGameReady = false;
            gameStarted = false;
            isLocked = false;
            matchedPairs = 0;
            attempts = 0;
            elapsedSeconds = 0;
            currentScore = 0;
            flippedCards = [];
            winOverlay.classList.remove('visible');

            // Generate cards but keep them face-down
            cards = generateCards();
            renderBoard(false);

            // Update UI
            updateStats();
            timeDisplay.textContent = '0s';
            timerDisplay.textContent = '⏱️ 0s';
            timerDisplay.classList.remove('warning');
            statusText.textContent = '⏳ Press "New Game" to start';
            statusText.className = 'status-text waiting';
            scoreDisplay.textContent = '—';
            phaseBanner.className = 'phase-banner idle';
            phaseBanner.textContent = '🔄 Click "New Game" to start';
            newGameBtn.disabled = false;

            loadBestScore();
        }

        // ----- Card Generation -----
        function generateCards() {
            const numPairs = totalPairs;
            let deck = [];

            if (currentMode === 'colors') {
                for (let i = 0; i < numPairs; i++) {
                    const colorIndex = i % 32;
                    deck.push({ id: i, content: `color-${colorIndex}`, type: 'color' });
                    deck.push({ id: i, content: `color-${colorIndex}`, type: 'color' });
                }
            } else {
                for (let i = 0; i < numPairs; i++) {
                    const emojiIndex = i % EMOJIS.length;
                    deck.push({ id: i, content: EMOJIS[emojiIndex], type: 'emoji' });
                    deck.push({ id: i, content: EMOJIS[emojiIndex], type: 'emoji' });
                }
            }

            for (let i = deck.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [deck[i], deck[j]] = [deck[j], deck[i]];
            }

            return deck.map((card, index) => ({
                ...card,
                index: index,
                isFlipped: false,
                isMatched: false
            }));
        }

        // ----- Rendering -----
        function renderBoard(flipAll = false) {
            board.innerHTML = '';
            cards.forEach((card, index) => {
                const cardEl = document.createElement('div');
                cardEl.className = 'card';
                if (card.isFlipped || flipAll) cardEl.classList.add('flipped');
                if (card.isMatched) cardEl.classList.add('matched');
                if (isMemorizePhase || !isGameActive) cardEl.classList.add('disabled');
                cardEl.dataset.index = index;

                const inner = document.createElement('div');
                inner.className = 'card-inner';

                const back = document.createElement('div');
                back.className = 'card-back';

                const front = document.createElement('div');
                front.className = 'card-front';
                const content = document.createElement('div');
                content.className = 'card-content';

                if (card.type === 'color') {
                    content.classList.add('color-mode');
                    content.classList.add(card.content);
                } else {
                    content.classList.add('emoji-mode');
                    content.textContent = card.content;
                }

                front.appendChild(content);
                inner.appendChild(back);
                inner.appendChild(front);
                cardEl.appendChild(inner);

                cardEl.addEventListener('click', () => onCardClick(index));

                board.appendChild(cardEl);
            });

            updateStats();
        }

        function updateCard(index) {
            const cardEl = board.children[index];
            if (!cardEl) return;
            const card = cards[index];

            cardEl.className = 'card';
            if (card.isFlipped) cardEl.classList.add('flipped');
            if (card.isMatched) cardEl.classList.add('matched');
            if (isMemorizePhase || !isGameActive) cardEl.classList.add('disabled');
        }

        function updateStats() {
            attemptsDisplay.textContent = attempts;
            matchesDisplay.textContent = matchedPairs;
        }

        function updateTimer() {
            if (gameStarted && !isLocked && !isMemorizePhase && isGameActive) {
                elapsedSeconds = (Date.now() - startTime) / 1000;
                const display = elapsedSeconds.toFixed(1);
                timeDisplay.textContent = display + 's';
                timerDisplay.textContent = '⏱️ ' + display + 's';

                if (elapsedSeconds > 60) {
                    timerDisplay.classList.add('warning');
                } else {
                    timerDisplay.classList.remove('warning');
                }
            }
        }

        function updatePhaseBanner(phase, remaining = null) {
            phaseBanner.className = 'phase-banner';

            if (phase === 'memorize') {
                phaseBanner.classList.add('memorize');
                phaseBanner.textContent = `👀 Memorize the ${currentMode}... ${remaining}s`;
            } else if (phase === 'matching') {
                phaseBanner.classList.add('matching');
                phaseBanner.textContent = '🧠 Find the matching pairs!';
            } else if (phase === 'ready') {
                phaseBanner.classList.add('ready');
                phaseBanner.textContent = '✅ Ready! Start matching!';
            } else if (phase === 'idle') {
                phaseBanner.classList.add('idle');
                phaseBanner.textContent = '🔄 Click "New Game" to start';
            }
        }

        // ============================================================
        //  START NEW GAME — Button click triggers memorize phase
        // ============================================================

        function startNewGame() {
            // Clear any existing timers
            if (timerInterval) clearInterval(timerInterval);
            if (memorizeTimer) clearInterval(memorizeTimer);
            timerInterval = null;
            memorizeTimer = null;

            // Reset state
            isGameActive = true;
            isMemorizePhase = true;
            isGameReady = false;
            gameStarted = false;
            isLocked = false;
            matchedPairs = 0;
            attempts = 0;
            elapsedSeconds = 0;
            currentScore = 0;
            flippedCards = [];
            remainingMemorizeTime = MEMORIZE_TIME;
            winOverlay.classList.remove('visible');

            // Generate new shuffled cards
            cards = generateCards();

            // Flip all cards face-up
            cards.forEach(c => c.isFlipped = true);
            renderBoard(true);
            updateStats();

            // Update UI
            newGameBtn.disabled = true;
            statusText.textContent = '👀 Memorize the colors...';
            statusText.className = 'status-text waiting';
            timeDisplay.textContent = '0s';
            timerDisplay.textContent = '⏱️ 0s';
            timerDisplay.classList.remove('warning');
            scoreDisplay.textContent = '—';

            updatePhaseBanner('memorize', remainingMemorizeTime);
            playMemorizeStart();

            // Start countdown
            memorizeTimer = setInterval(() => {
                remainingMemorizeTime--;
                updatePhaseBanner('memorize', remainingMemorizeTime);

                if (remainingMemorizeTime <= 0) {
                    clearInterval(memorizeTimer);
                    memorizeTimer = null;
                    endMemorizePhase();
                }
            }, 1000);
        }

        function endMemorizePhase() {
            isMemorizePhase = false;
            isGameReady = true;

            // Flip all cards back down
            cards.forEach(c => c.isFlipped = false);
            renderBoard(false);

            updatePhaseBanner('ready');
            playMemorizeEnd();

            statusText.textContent = '🔍 Start matching!';
            statusText.className = 'status-text playing';
            newGameBtn.disabled = false;

            // Enable cards
            document.querySelectorAll('.card').forEach(el => {
                el.classList.remove('disabled');
            });

            // Reset timer — it will start on first click
            gameStarted = false;
            startTime = 0;
            elapsedSeconds = 0;
            timeDisplay.textContent = '0s';
            timerDisplay.textContent = '⏱️ 0s';

            setTimeout(() => {
                statusText.textContent = '👆 Click a card to start the timer!';
            }, 500);
        }

        // ============================================================
        //  Game Logic
        // ============================================================

        function onCardClick(index) {
            if (isLocked) return;
            if (isMemorizePhase) return;
            if (!isGameReady) return;
            if (!isGameActive) return;

            const card = cards[index];
            if (card.isFlipped || card.isMatched) return;
            if (flippedCards.length >= 2) return;

            if (!gameStarted) {
                gameStarted = true;
                startTime = Date.now();
                timerInterval = setInterval(updateTimer, 100);
                statusText.textContent = '🧠 Keep going!';
                statusText.className = 'status-text playing';
                updatePhaseBanner('matching');
            }

            card.isFlipped = true;
            updateCard(index);
            playFlip();

            flippedCards.push(index);

            if (flippedCards.length === 2) {
                attempts++;
                updateStats();
                checkMatch();
            }
        }

        function checkMatch() {
            isLocked = true;
            const [i1, i2] = flippedCards;
            const card1 = cards[i1];
            const card2 = cards[i2];

            if (card1.id === card2.id) {
                setTimeout(() => {
                    card1.isMatched = true;
                    card2.isMatched = true;
                    card1.isFlipped = false;
                    card2.isFlipped = false;
                    matchedPairs++;
                    updateStats();
                    updateCard(i1);
                    updateCard(i2);
                    flippedCards = [];
                    isLocked = false;
                    playMatch();

                    if (matchedPairs === totalPairs) {
                        winGame();
                    }
                }, 300);
            } else {
                playMismatch();
                setTimeout(() => {
                    card1.isFlipped = false;
                    card2.isFlipped = false;
                    updateCard(i1);
                    updateCard(i2);
                    flippedCards = [];
                    isLocked = false;
                }, 600);
            }
        }

        function winGame() {
            clearInterval(timerInterval);
            const finalTime = elapsedSeconds;

            const attemptScore = Math.max(0, (10 - attempts / 2) * 10);
            const timeScore = Math.max(0, (60 - finalTime) * 1.5);
            currentScore = Math.round(Math.min(100, attemptScore + timeScore));

            const scoreValue = attempts * 100 + Math.round(finalTime * 10);
            const isNewBest = scoreValue < bestScore;

            if (isNewBest) {
                bestScore = scoreValue;
                saveBestScore();
                updateBestDisplay();
                playHighScore();
                setTimeout(playWin, 400);
                setTimeout(playWin, 800);
            } else {
                playWin();
            }

            winAttempts.textContent = attempts;
            winTime.textContent = finalTime.toFixed(1) + 's';
            winScore.textContent = currentScore + (isNewBest ? ' 🏆 New Best!' : '');
            winOverlay.classList.add('visible');

            statusText.textContent = '🎉 All matched!';
            statusText.className = 'status-text win';

            scoreDisplay.textContent = currentScore + (isNewBest ? ' 🏆' : '');
            updatePhaseBanner('ready');
            phaseBanner.textContent = '🎉 Complete!';
            phaseBanner.className = 'phase-banner ready';
            newGameBtn.disabled = false;
        }

        // ============================================================
        //  Event Handlers
        // ============================================================

        newGameBtn.addEventListener('click', startNewGame);
        playAgainBtn.addEventListener('click', startNewGame);

        difficultySelect.addEventListener('change', updateDifficulty);

        modeToggleButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                if (btn.dataset.mode !== currentMode) {
                    updateMode(btn.dataset.mode);
                }
            });
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'n' || e.key === 'N') {
                if (!newGameBtn.disabled) startNewGame();
            }
            if (e.key === ' ' || e.key === 'Enter') {
                if (winOverlay.classList.contains('visible')) {
                    startNewGame();
                }
            }
        });

        // ============================================================
        //  Init
        // ============================================================

        difficultySelect.value = '6';
        currentDifficulty = 6;
        totalPairs = 18;
        totalPairsDisplay.textContent = totalPairs;
        board.className = 'board grid-6';

        // Generate initial cards (face-down)
        cards = generateCards();
        renderBoard(false);
        loadBestScore();
        resetToIdle();

        console.log('🧠 Memory Match — Ultimate Edition V2 loaded!');
        console.log(`⏱️ Memorize time: ${MEMORIZE_TIME}s`);
        console.log(`📐 Difficulty: ${currentDifficulty}×${currentDifficulty}`);
        console.log(`🎨 Mode: ${currentMode}`);
        console.log('🔊 Click the speaker icon to toggle sound');
        console.log('⌨️  Keyboard: N=New Game, Space=Play Again');
    </script>

